# =============================================================================
# E2E Test Configuration
# =============================================================================
# Copy this file to .env and fill in the values.
# .env is git-ignored and should never be committed.
# =============================================================================

# --- Target application URL ---
# Testing environment:
#   BASE_URL=https://...
# Local environment:
#   BASE_URL=http://localhost:8080

# --- Application context path ---
APP_CONTEXT_PATH=/bankid-registrator

# --- Admin dashboard credentials (Spring Security) ---
ADMIN_USERNAME=
ADMIN_PASSWORD=

# --- BankID sandbox ---
# The link text of the fake identity to select on the BankID sandbox login page.
# Example: JanN
BANKID_SANDBOX_IDENTITY=JanN
# Optional: enables senior registration and renewal voucher scenarios (age 70+).
BANKID_SANDBOX_IDENTITY_SENIOR=LeosV

# --- Tester's Toolkit ---
# Capitalized prefix for the middle name used in fake BankID identities.
# The test appends 7 random lowercase characters to this prefix.
# Example: "Ete" → "Eteqwertyu" (where "qwertyu" is random)
TEST_MIDDLE_NAME_PREFIX=Ete
# Optional: when set, E2E will store this tester email in the Tester's Toolkit
# so the app sends extra copies of all emails to this inbox in non-production.
E2E_TESTER_EMAIL=tester@lib.cas.cz

# --- Patron password ---
# Password to set for newly created Aleph patron accounts during registration tests.
# Must satisfy the app's password policy.
PATRON_PASSWORD=Random-psw1

# --- Employee testing ---
# Email domain for CAS employees (random local part is generated per test run).
EMPLOYEE_EMAIL_DOMAIN=lib.cas.cz
# Absolute path to a small PDF/JPG file to upload as employee confirmation document.
EMPLOYEE_DOC_PATH=/absolute/path/to/e2e/fixtures/employee-doc.pdf

# --- Comgate test payment ---
# Test card number for Comgate sandbox (if required by their test UI).
COMGATE_TEST_CARD=

# --- Timeouts (milliseconds) ---
# How long to wait for LDAP sync progress loader to complete.
LDAP_SYNC_TIMEOUT_MS=90000

# --- Screenshot output directory ---
SCREENSHOT_DIR=screenshots

# --- Video recording (optional) ---
# Allowed values: off, on, retain-on-failure, on-first-retry
# Default when omitted: on-first-retry
# E2E_VIDEO_MODE=retain-on-failure

# --- Voucher recalculation / invalid-voucher E2E coverage ---
# Invalid code used when testing voucher validation error states.
INVALID_VOUCHER=INVALID-CODE
# Optional reusable valid partial-discount voucher codes. If omitted, the
# affected Playwright specs create fresh partial vouchers dynamically.
# If you set these, make sure they remain usable across the scenarios you run.
PARTIAL_DISCOUNT_VOUCHER1=
PARTIAL_DISCOUNT_VOUCHER2=

# --- Renewal fines scenarios (optional) ---
# These blocks are used by env-gated renewal tests for patrons that already have
# manually prepared outstanding fines in Aleph. If a block is incomplete, the
# corresponding fines scenario is skipped.
#
# Bootstrap workflow:
# 1. Fill only the *_BANKID_IDENTITY values below.
# 2. Run the renewal bootstrap spec to create candidate patrons.
# 3. Copy the printed *_MIDDLE_NAME / *_PATRON_BARCODE / *_PATRON_ALEPH_ID
#    values back into your real .env.
# 4. Manually add fines to those patrons in Aleph.
# 5. Run the env-gated renewal fines tests.

# Normal customer, no voucher, fines > 0 CZK
RENEWAL_FINES_NORMAL_NO_VOUCHER_BANKID_IDENTITY=
RENEWAL_FINES_NORMAL_NO_VOUCHER_MIDDLE_NAME=
RENEWAL_FINES_NORMAL_NO_VOUCHER_PATRON_BARCODE=
RENEWAL_FINES_NORMAL_NO_VOUCHER_PATRON_ALEPH_ID=

# Normal customer, partial voucher, fines > 0 CZK
RENEWAL_FINES_NORMAL_PARTIAL_VOUCHER_BANKID_IDENTITY=
RENEWAL_FINES_NORMAL_PARTIAL_VOUCHER_MIDDLE_NAME=
RENEWAL_FINES_NORMAL_PARTIAL_VOUCHER_PATRON_BARCODE=
RENEWAL_FINES_NORMAL_PARTIAL_VOUCHER_PATRON_ALEPH_ID=

# Normal customer, 100% voucher, fines > 0 CZK, submit only
RENEWAL_FINES_NORMAL_FULL_VOUCHER_SUBMIT_ONLY_BANKID_IDENTITY=
RENEWAL_FINES_NORMAL_FULL_VOUCHER_SUBMIT_ONLY_MIDDLE_NAME=
RENEWAL_FINES_NORMAL_FULL_VOUCHER_SUBMIT_ONLY_PATRON_BARCODE=
RENEWAL_FINES_NORMAL_FULL_VOUCHER_SUBMIT_ONLY_PATRON_ALEPH_ID=

# Normal customer, 100% voucher, fines > 0 CZK, submit and pay
RENEWAL_FINES_NORMAL_FULL_VOUCHER_SUBMIT_AND_PAY_BANKID_IDENTITY=
RENEWAL_FINES_NORMAL_FULL_VOUCHER_SUBMIT_AND_PAY_MIDDLE_NAME=
RENEWAL_FINES_NORMAL_FULL_VOUCHER_SUBMIT_AND_PAY_PATRON_BARCODE=
RENEWAL_FINES_NORMAL_FULL_VOUCHER_SUBMIT_AND_PAY_PATRON_ALEPH_ID=

# Employee, no voucher, fines > 0 CZK, submit only
RENEWAL_FINES_EMPLOYEE_NO_VOUCHER_SUBMIT_ONLY_BANKID_IDENTITY=
RENEWAL_FINES_EMPLOYEE_NO_VOUCHER_SUBMIT_ONLY_MIDDLE_NAME=
RENEWAL_FINES_EMPLOYEE_NO_VOUCHER_SUBMIT_ONLY_PATRON_BARCODE=
RENEWAL_FINES_EMPLOYEE_NO_VOUCHER_SUBMIT_ONLY_PATRON_ALEPH_ID=

# Employee, no voucher, fines > 0 CZK, submit and pay
RENEWAL_FINES_EMPLOYEE_NO_VOUCHER_SUBMIT_AND_PAY_BANKID_IDENTITY=
RENEWAL_FINES_EMPLOYEE_NO_VOUCHER_SUBMIT_AND_PAY_MIDDLE_NAME=
RENEWAL_FINES_EMPLOYEE_NO_VOUCHER_SUBMIT_AND_PAY_PATRON_BARCODE=
RENEWAL_FINES_EMPLOYEE_NO_VOUCHER_SUBMIT_AND_PAY_PATRON_ALEPH_ID=
